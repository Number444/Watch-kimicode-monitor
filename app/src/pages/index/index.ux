<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <!-- 头部：标题 + 套餐档位（两页共享） -->
    <div class="header">
      <text class="title">Kimi Code</text>
      <text class="plan-badge">{{ planLabel }}</text>
    </div>

    <swiper class="swiper" indicator="true" onchange="onSwiperChange">
      <!-- 第 1 页：纯额度展示（旧版样式） -->
      <div class="slide">
        <div class="card">
          <div class="row">
            <text class="label">5小时窗口</text>
            <text class="pct" style="color: {{ fiveHourColor }};">{{ fiveHourPctText }}</text>
          </div>
          <div class="bar-track">
            <div class="bar-fill"
                 style="width: {{ fiveHourBarWidth }}%; background-color: {{ fiveHourColor }};"></div>
          </div>
          <div class="row">
            <text class="sub">剩余 {{ fiveHourText }}</text>
            <text class="sub">重置 {{ fiveHourReset }}</text>
          </div>
        </div>

        <div class="card">
          <div class="row">
            <text class="label">周额度</text>
            <text class="pct" style="color: {{ weeklyColor }};">{{ weeklyPctText }}</text>
          </div>
          <div class="bar-track">
            <div class="bar-fill"
                 style="width: {{ weeklyBarWidth }}%; background-color: {{ weeklyColor }};"></div>
          </div>
          <div class="row">
            <text class="sub">剩余 {{ weeklyText }}</text>
            <text class="sub">重置 {{ weeklyReset }}</text>
          </div>
        </div>

        <text class="updated" if="{{ updatedAt }}">更新于 {{ updatedAt }}</text>
      </div>

      <!-- 第 2 页：控制 + 诊断 -->
      <div class="slide" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
        <input class="refresh-btn" type="button" value="{{ btnValue }}"
               style="background-color: {{ btnColor }};" onclick="doRefresh" />
        <text class="diag">{{ diagText }}</text>
      </div>
    </swiper>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 24px 18px;
    background-color: #000000;
  }
  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .title {
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
  }
  .plan-badge {
    font-size: 20px;
    color: #0a84ff;
    border: 1px solid #0a84ff;
    border-radius: 12px;
    padding: 2px 12px;
  }
  .swiper {
    width: 100%;
    height: 380px;
    indicator-color: #38383a;
    indicator-selected-color: #0a84ff;
    indicator-size: 8px;
  }
  .slide {
    flex-direction: column;
    width: 100%;
    height: 100%;
  }
  .card {
    flex-direction: column;
    background-color: #1c1c1e;
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 14px;
  }
  .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .label {
    font-size: 24px;
    color: #ebebf5;
  }
  .pct {
    font-size: 36px;
    font-weight: bold;
  }
  .bar-track {
    width: 100%;
    height: 12px;
    background-color: #38383a;
    border-radius: 6px;
    margin: 12px 0;
  }
  .bar-fill {
    height: 12px;
    border-radius: 6px;
  }
  .sub {
    font-size: 18px;
    color: #8e8e93;
  }
  .updated {
    font-size: 16px;
    color: #636366;
    text-align: center;
    margin-top: 4px;
  }
  .diag {
    font-size: 14px;
    color: #636366;
    margin-top: 12px;
  }
  .refresh-btn {
    width: 300px;
    height: 64px;
    background-color: #0a84ff;
    border-radius: 16px;
    margin-top: 4px;
    font-size: 26px;
    color: #ffffff;
  }
</style>

<script>
  import storage from '@system.storage'
  import interconnect from '@system.interconnect'
  import fetch from '@system.fetch'
  import config from '../../common/config.js'
  import quota from '../../common/quota.js'

  const CACHE_KEY = 'quota_cache'
  const APP_VER = '0.4.1'
  const DIAG_MAX_LINES = 8
  const REQ_TIMEOUT_MS = 15000
  const DIAG_INIT = '等待事件…'

  // 刷新按钮的屏幕坐标命中区（clientX/Y，相对可视区域）
  // 布局：padding-top 24 + header 46 + swiper 内 margin-top 4 → 按钮 y 74..138，x 18..318
  const BTN_RECT = { x1: 14, y1: 70, x2: 322, y2: 144 }
  const TAP_MAX_MOVE = 20

  const COLOR_OK = '#30d158'
  const COLOR_FAIL = '#ff453a'

  export default {
    private: {
      planLabel: '--',
      fiveHourPctText: '--',
      fiveHourBarWidth: 0,
      fiveHourColor: '#8e8e93',
      fiveHourText: '--',
      fiveHourReset: '--',
      weeklyPctText: '--',
      weeklyBarWidth: 0,
      weeklyColor: '#8e8e93',
      weeklyText: '--',
      weeklyReset: '--',
      btnValue: '刷 新',
      btnColor: '#0a84ff',
      updatedAt: '',
      diagText: DIAG_INIT,

      // 非视图状态（一律不用下划线前缀，避免框架跳过初始化）
      cacheTime: 0,
      reset5hMs: 0,
      resetWeeklyMs: 0,
      tickTimer: 0,
      conn: null,
      fetching: false,
      refreshing: false,
      reqTimeoutTimer: 0,
      btnRevertTimer: 0,
      lastRefreshTap: 0,
      touchStartX: -1,
      touchStartY: -1,
      curPage: -1 // -1=未知(swiper change事件可能不派发), 0/1=已确认页码
    },

    onInit() {
      try {
        this.diag('v' + APP_VER + ' 启动 source=' + config.DATA_SOURCE +
          ' key=' + (config.API_KEY ? '已配置' : '空'))
        this.diag('fetch接口=' + (typeof fetch.fetch) +
          ' interconnect=' + (typeof interconnect.instance))
        this.setupInterconnect()
      } catch (e) {
        this.diag('onInit异常: ' + this.errText(e))
      }
    },

    onShow() {
      this.startTicker()
      this.loadCache()
    },

    onHide() {
      this.stopTicker()
    },

    onDestroy() {
      this.stopTicker()
    },

    /* ---------- 诊断工具（纯字符串累加，不依赖数组字段） ---------- */

    diag(msg) {
      try {
        const t = new Date()
        const p = function (n) { return ('0' + n).slice(-2) }
        const line = p(t.getHours()) + ':' + p(t.getMinutes()) + ':' + p(t.getSeconds()) + ' ' + msg
        let text = (this.diagText === DIAG_INIT) ? line : this.diagText + '\n' + line
        const lines = text.split('\n')
        if (lines.length > DIAG_MAX_LINES) text = lines.slice(-DIAG_MAX_LINES).join('\n')
        this.diagText = text
      } catch (e) { /* 日志本身绝不抛错 */ }
      console.info('[diag] ' + msg)
    },

    errText(e) {
      if (e === undefined || e === null) return '无详情'
      if (typeof e === 'string') return e
      try { return JSON.stringify(e) } catch (x) { return '' + e }
    },

    failText(data, code) {
      let s = ''
      if (data !== undefined && data !== null) s = this.errText(data)
      if (code !== undefined) s += (s ? ' ' : '') + 'code=' + code
      return s || '无详情'
    },

    /* ---------- 安全定时器 ---------- */

    safeTimeout(fn, ms) {
      try { return setTimeout(fn, ms) } catch (e) { this.diag('setTimeout不可用: ' + this.errText(e)); return 0 }
    },

    safeClearTimeout(id) {
      try { if (id) clearTimeout(id) } catch (e) { /* ignore */ }
    },

    /* ---------- 触摸坐标命中（绕开子组件 click 不派发的问题） ---------- */

    touchXY(e) {
      try {
        const list = (e.changedTouches && e.changedTouches.length) ? e.changedTouches : e.touches
        if (!list || !list.length) return null
        const t = list[0]
        const x = (t.clientX !== undefined) ? t.clientX : t.pageX
        const y = (t.clientY !== undefined) ? t.clientY : t.pageY
        if (x === undefined || y === undefined) return null
        return { x: x, y: y }
      } catch (err) { return null }
    },

    onTouchStart(e) {
      const p = this.touchXY(e)
      if (p) {
        this.touchStartX = p.x
        this.touchStartY = p.y
      }
    },

    onTouchEnd(e) {
      const p = this.touchXY(e)
      const sx = this.touchStartX
      const sy = this.touchStartY
      this.touchStartX = -1
      this.touchStartY = -1
      if (!p || sx < 0) return
      // 位移大 = 滑动手势（翻页），不当作点按
      if (Math.abs(p.x - sx) > TAP_MAX_MOVE || Math.abs(p.y - sy) > TAP_MAX_MOVE) return
      // 确认在第 1 页时不响应（该坐标区是 5 小时卡片，避免误触）
      if (this.curPage === 0) return
      if (p.x >= BTN_RECT.x1 && p.x <= BTN_RECT.x2 && p.y >= BTN_RECT.y1 && p.y <= BTN_RECT.y2) {
        this.diag('坐标命中按钮区')
        this.doRefresh()
      }
    },

    onSwiperChange(e) {
      if (e && e.index !== undefined) this.curPage = e.index
    },

    /* ---------- 刷新按钮状态机（蓝常态/灰刷新中/绿成功/红失败） ---------- */

    setBtn(state, msg) {
      const self = this
      this.safeClearTimeout(this.btnRevertTimer)
      this.btnRevertTimer = 0
      if (state === 'busy') {
        this.btnValue = '刷新中…'
        this.btnColor = '#48484a'
      } else if (state === 'ok') {
        this.btnValue = '✓ 已更新'
        this.btnColor = COLOR_OK
        this.btnRevertTimer = this.safeTimeout(function () { self.resetBtn() }, 2000)
      } else if (state === 'fail') {
        this.btnValue = '✗ ' + (msg || '失败')
        this.btnColor = COLOR_FAIL
        this.btnRevertTimer = this.safeTimeout(function () { self.resetBtn() }, 3000)
      }
    },

    resetBtn() {
      this.btnValue = '刷 新'
      this.btnColor = '#0a84ff'
    },

    /** 一次请求流程结束：ok=成功/失败，msg=原因摘要 */
    refreshDone(ok, msg) {
      this.refreshing = false
      this.safeClearTimeout(this.reqTimeoutTimer)
      this.reqTimeoutTimer = 0
      this.diag((ok ? '成功: ' : '失败: ') + msg)
      this.setBtn(ok ? 'ok' : 'fail', msg)
    },

    /** 进行中：按钮置灰 + 记录日志 */
    refreshBusy(msg) {
      this.setBtn('busy')
      this.diag(msg)
    },

    /* ---------- 手机推送通道（主通道） ---------- */

    setupInterconnect() {
      try {
        if (!interconnect || typeof interconnect.instance !== 'function') {
          this.diag('interconnect 模块不可用')
          return
        }
        const conn = interconnect.instance()
        if (!conn) {
          this.diag('interconnect.instance() 返回空')
          return
        }
        this.conn = conn
        this.diag('手机通道已初始化')
        const self = this
        conn.onmessage = function (res) {
          const str = res && res.data
          self.diag('收到推送 ' + (str ? str.length : 0) + ' 字节')
          if (!str) return
          self.handlePushedData(str)
        }
        conn.onerror = function (e) {
          self.diag('通道错误: ' + self.errText(e))
        }
      } catch (e) {
        this.diag('通道初始化异常: ' + this.errText(e))
      }
    },

    /** 解析手机推送的数据：兼容裸 usages JSON 与 {type:'quota', payload:{...}} 包装 */
    handlePushedData(str) {
      let obj = null
      try {
        obj = JSON.parse(str)
      } catch (e) {
        this.diag('推送非JSON: ' + str.slice(0, 40))
        return
      }
      const payload = obj.payload || obj
      if (payload && (payload.usage || payload.limits)) {
        this.saveCache(payload)
        this.renderUsages(payload)
        this.refreshDone(true, '收到手机推送')
      } else {
        this.diag('推送缺少usage/limits字段')
      }
    },

    /** 向手机端请求拉取最新额度（手机端监听 type:'pull'） */
    sendPullRequest() {
      if (!this.conn) {
        this.diag('pull中止: 无连接实例')
        this.refreshDone(false, '手机通道未就绪')
        return
      }
      const self = this
      this.diag('发送pull请求…')
      try {
        this.conn.send({
          data: { type: 'pull', pkg: config.PKG_NAME, ts: Date.now() },
          success: function () {
            self.refreshBusy('已向手机请求数据…')
            self.diag('pull发送成功')
          },
          fail: function (data, code) {
            self.diag('pull失败: ' + self.failText(data, code))
            self.refreshDone(false, '手机未连接')
          }
        })
      } catch (e) {
        this.diag('pull异常: ' + this.errText(e))
        this.refreshDone(false, '手机通道不可用')
      }
    },

    /* ---------- 手环直连通道（已实测米环9Pro可用） ---------- */

    tryDirectFetch() {
      if (this.fetching) return
      this.fetching = true
      this.refreshBusy('直连查询中…')
      this.diag('直连GET ' + config.API_URL)
      const self = this
      try {
        fetch.fetch({
          url: config.API_URL,
          method: 'GET',
          header: { 'Authorization': 'Bearer ' + config.API_KEY },
          responseType: 'json',
          success: function (res) {
            self.fetching = false
            self.diag('直连返回 HTTP=' + (res && res.code))
            if (res.code === 200 && res.data) {
              try {
                const data = typeof res.data === 'string' ? JSON.parse(res.data) : res.data
                self.saveCache(data)
                self.renderUsages(data)
                self.refreshDone(true, '直连更新成功')
              } catch (e) {
                self.diag('JSON解析异常: ' + self.errText(e))
                self.refreshDone(false, '响应解析失败')
              }
            } else if (res.code === 401) {
              self.diag('响应体: ' + self.errText(res.data).slice(0, 60))
              self.refreshDone(false, 'API Key 无效(401)')
            } else {
              self.diag('响应体: ' + self.errText(res.data).slice(0, 60))
              self.refreshDone(false, '接口异常 HTTP ' + res.code)
            }
          },
          fail: function (data, code) {
            self.fetching = false
            self.diag('直连失败: ' + self.failText(data, code))
            if (config.DATA_SOURCE === 'auto') {
              self.refreshBusy('直连失败，转手机推送')
              self.sendPullRequest()
            } else {
              self.refreshDone(false, '直连失败')
            }
          }
        })
      } catch (e) {
        this.fetching = false
        this.diag('直连异常: ' + self.errText(e))
        if (config.DATA_SOURCE === 'auto') {
          this.refreshBusy('本机不支持直连，转手机推送')
          this.sendPullRequest()
        } else {
          this.refreshDone(false, '本机不支持直连')
        }
      }
    },

    /* ---------- 缓存与刷新策略 ---------- */

    loadCache() {
      const self = this
      try {
        storage.get({
          key: CACHE_KEY,
          success: function (raw) {
            if (raw) {
              try {
                const obj = JSON.parse(raw)
                self.cacheTime = obj.time || 0
                self.renderUsages(obj.data)
                self.updatedAt = quota.fmtTime(obj.time)
                self.diag('缓存命中')
              } catch (e) {
                self.diag('缓存损坏: ' + self.errText(e))
              }
            } else {
              self.diag('无缓存')
            }
            self.maybeRefresh()
          },
          fail: function (data, code) {
            self.diag('读缓存失败: ' + self.failText(data, code))
            self.maybeRefresh()
          }
        })
      } catch (e) {
        this.diag('storage异常: ' + this.errText(e))
        this.maybeRefresh()
      }
    },

    saveCache(data) {
      this.cacheTime = Date.now()
      this.updatedAt = quota.fmtTime(this.cacheTime)
      const self = this
      try {
        storage.set({
          key: CACHE_KEY,
          value: JSON.stringify({ time: this.cacheTime, data: data }),
          fail: function (d, c) { self.diag('写缓存失败: ' + self.failText(d, c)) }
        })
      } catch (e) {
        this.diag('写缓存异常: ' + this.errText(e))
      }
    },

    /** 缓存过期才请求新数据（onShow 去抖，避免亮屏反复请求） */
    maybeRefresh() {
      const fresh = (Date.now() - this.cacheTime) < config.CACHE_TTL_MS
      if (fresh) {
        this.diag('缓存新鲜，跳过请求')
        return
      }
      this.requestFresh()
    },

    requestFresh() {
      const canDirect = config.DATA_SOURCE !== 'push' && config.API_KEY
      this.diag(canDirect ? '策略: 直连优先' : '策略: 手机推送')
      if (canDirect) {
        this.tryDirectFetch()
      } else {
        this.sendPullRequest()
      }
    },

    /** 刷新入口（input 的 onclick + 根容器坐标命中共用，防抖幂等） */
    doRefresh() {
      const now = Date.now()
      if (now - (this.lastRefreshTap || 0) < 800) return
      this.lastRefreshTap = now
      this.diag('手动刷新触发')
      if (this.refreshing) {
        this.diag('刷新进行中，忽略')
        return
      }
      this.refreshing = true
      this.cacheTime = 0 // 强制视为过期
      this.refreshBusy('刷新中…')
      // 超时保护（安全定时器）
      const self = this
      this.safeClearTimeout(this.reqTimeoutTimer)
      this.reqTimeoutTimer = this.safeTimeout(function () {
        if (self.refreshing) {
          self.diag('请求超时(' + (REQ_TIMEOUT_MS / 1000) + 's)')
          self.refreshDone(false, '请求超时')
        }
      }, REQ_TIMEOUT_MS)
      this.requestFresh()
    },

    /* ---------- 渲染与倒计时 ---------- */

    renderUsages(raw) {
      const vm = quota.parseUsages(raw)
      this.planLabel = vm.plan

      this.applyQuota('fiveHour', vm.fiveHour)
      this.applyQuota('weekly', vm.weekly)
      this.reset5hMs = vm.fiveHour.resetMs
      this.resetWeeklyMs = vm.weekly.resetMs
      this.tickCountdown()
    },

    applyQuota(prefix, q) {
      const pctText = q.pct === null ? '--' : q.pct + '%'
      this[prefix + 'PctText'] = pctText
      this[prefix + 'BarWidth'] = q.pct === null ? 0 : q.pct
      this[prefix + 'Color'] = quota.colorFor(q.pct)
      this[prefix + 'Text'] =
        (q.remaining === null || q.limit === null) ? '--' : q.remaining + ' / ' + q.limit
    },

    startTicker() {
      this.stopTicker()
      const self = this
      this.tickTimer = setInterval(function () {
        self.tickCountdown()
      }, 1000)
    },

    stopTicker() {
      if (this.tickTimer) {
        clearInterval(this.tickTimer)
        this.tickTimer = 0
      }
    },

    tickCountdown() {
      const now = Date.now()
      this.fiveHourReset = quota.countdownText(now, this.reset5hMs)
      this.weeklyReset = quota.countdownText(now, this.resetWeeklyMs)
    }
  }
</script>
